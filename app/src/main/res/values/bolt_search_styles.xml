<resources>
    <style name="BoltSearchTheme">
        <item name="android:textCursorDrawable">@drawable/bolt_search_cursor</item>
    </style>
    <style name="BoltAliasBadge">
        <item name="android:gravity">center</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:maxWidth">96dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:foreground">@drawable/bolt_search_press</item>
    </style>

    <style name="BoltHomeMenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:background">@drawable/bolt_search_press</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:fontFamily">?attr/mainFontFamily</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/boltHomeMenuTextColor</item>
        <item name="drawableTint">?attr/boltHomeMenuTextColor</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="FrostedGlassOverlay">
        <item name="boltGlassReflectionColor">#619AC5FA</item>
        <item name="boltRowBottomColor">#17233961</item>
        <item name="boltRowOutlineColor">#4BB5D3F3</item>
        <item name="boltSettingsCardBottomColor">@color/bolt_glass_settings_card_bottom</item>
        <item name="boltDockColor">#CD26344B</item>
        <item name="boltPanelColor">#D21A273C</item>
        <item name="boltPanelOutlineColor">#6D9AB9D9</item>
        <item name="boltRowColor">#54667D9E</item>
        <item name="boltDialogTopColor">@color/bolt_glass_dialog_top</item>
        <item name="boltDialogBottomColor">@color/bolt_glass_dialog_bottom</item>
        <item name="boltDialogOutlineColor">@color/bolt_glass_dialog_outline</item>
        <item name="boltPopupTopColor">@color/bolt_glass_dialog_top</item>
        <item name="boltPopupBottomColor">@color/bolt_glass_dialog_bottom</item>
        <item name="boltPopupOutlineColor">@color/bolt_glass_dialog_outline</item>
        <item name="boltSettingsSurfaceColor">@color/bolt_glass_settings_surface</item>
        <item name="boltSettingsCardColor">@color/bolt_glass_settings_card</item>
        <item name="boltSettingsCardOutlineColor">@color/bolt_glass_settings_outline</item>
        <item name="boltHomeMenuTextColor">?attr/primaryColor</item>
    </style>

    <style name="SmokedGlassOverlay">
        <item name="boltDockColor">#E818191C</item>
        <item name="boltPanelColor">#90191A1D</item>
        <item name="boltPanelOutlineColor">#406E7076</item>
        <item name="boltGlassReflectionColor">#25FFFFFF</item>
        <item name="boltGlassTopEdgeColor">#5AC8C9CC</item>
        <item name="boltRowColor">#D033353A</item>
        <item name="boltRowBottomColor">#D027292E</item>
        <item name="boltRowOutlineColor">#366F7279</item>
        <item name="boltSelectedRowColor">#DF454247</item>
        <item name="boltSelectedRowOutlineWidth">1dp</item>
        <item name="boltSelectedRowOutlineColor">#BDAA76</item>
        <item name="boltSelectedRowTextColor">#FFF8E8</item>
        <item name="boltSelectedRowSecondaryColor">#E3D8C3</item>
        <item name="boltSmokedControlColor">#AC36383D</item>
        <item name="boltDialogTopColor">#EC323439</item>
        <item name="boltDialogBottomColor">#EF24262B</item>
        <item name="boltDialogOutlineColor">#726F7379</item>
        <item name="boltPopupTopColor">?attr/boltDialogTopColor</item>
        <item name="boltPopupBottomColor">?attr/boltDialogBottomColor</item>
        <item name="boltPopupOutlineColor">?attr/boltDialogOutlineColor</item>
    </style>

    <style name="WindowsXpOverlay">
        <item name="boltDockTopColor">#79B8FF</item>
        <item name="boltDockColor">#114A9D</item>
        <item name="boltPanelColor">#D0E4FC</item>
        <item name="boltPanelOutlineColor">#2861AC</item>
        <item name="boltPanelCornerRadius">8dp</item>
        <item name="boltRowColor">#FFFDF5</item>
        <item name="boltRowBottomColor">#F1EFDF</item>
        <item name="boltRowOutlineColor">#B5CBE7</item>
        <item name="boltSelectedRowColor">#2358A6</item>
        <item name="boltSelectedRowOutlineColor">#17447F</item>
        <item name="boltSelectedRowOutlineWidth">1dp</item>
        <item name="boltSelectedRowTextColor">#FFFFFF</item>
        <item name="boltSelectedRowSecondaryColor">#E5F0FF</item>
        <item name="boltDialogTopColor">@color/bolt_xp_dialog_top</item>
        <item name="boltDialogBottomColor">@color/bolt_xp_dialog_bottom</item>
        <item name="boltDialogOutlineColor">#6E9CDC</item>
        <item name="boltPopupTopColor">?attr/boltDialogTopColor</item>
        <item name="boltPopupBottomColor">?attr/boltDialogBottomColor</item>
        <item name="boltPopupOutlineColor">?attr/boltDialogOutlineColor</item>
        <item name="boltSettingsSurfaceColor">@color/bolt_xp_settings_surface</item>
        <item name="boltSettingsCardColor">@color/bolt_xp_settings_card</item>
        <item name="boltSettingsCardBottomColor">@color/bolt_xp_settings_card_bottom</item>
        <item name="boltSettingsCardOutlineColor">#517DB9</item>
        <item name="boltHomeMenuTextColor">@color/bolt_xp_menu_text</item>
        <item name="boltResultTextColor">#172C46</item>
        <item name="boltResultSecondaryColor">#405779</item>
        <item name="boltResultActionColor">#172C46</item>
        <item name="boltSelectedTypoHintColor">#FFFFFF</item>
        <item name="boltSearchSectionColor">#204576</item>
        <item name="boltThunderDockColor">#28622B</item>
        <item name="boltThunderCursorColor">#FFFFFF</item>
        <item name="boltThunderMatchTextColor">#143E7B</item>
    </style>
</resources>
