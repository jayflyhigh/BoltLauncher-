<?xml version="1.0" encoding="utf-8"?>
<app.olauncher.ui.SearchGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/appRename"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rename"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bolt_search_idle"
        android:layoutDirection="ltr">

        <TextView
            android:id="@+id/homeSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/bolt_search_button_width"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/bolt_search"
            android:textColor="#BDBDBD"
            android:textSize="18sp" />

        <app.olauncher.ui.BoltSearchInput
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/bolt_search_button_width"
            android:background="@null"
            android:gravity="start|center_vertical"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:inputType="text|textNoSuggestions"
            android:paddingHorizontal="16dp"
            android:saveEnabled="false"
            android:singleLine="true"
            android:textCursorDrawable="@drawable/bolt_cursor_yellow"
            android:textSize="18sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/dockBolt"
            android:layout_width="@dimen/bolt_search_button_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:contentDescription="@string/bolt_enable_thunder"
            android:scaleType="center"
            app:srcCompat="@drawable/bolt_search_lightning"
            app:tint="@color/bolt_search_yellow" />
    </FrameLayout>
</app.olauncher.ui.SearchGestureLayout>
