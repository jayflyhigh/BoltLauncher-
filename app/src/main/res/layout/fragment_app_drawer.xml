<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@android:color/transparent" android:paddingTop="16dp">
<app.olauncher.ui.DockResultsView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginHorizontal="16dp" android:layout_marginBottom="8dp" android:background="@drawable/search_results_panel" android:clipToOutline="true" android:clipChildren="true" android:clipToPadding="true" android:paddingTop="8dp" android:paddingBottom="8dp" android:fadingEdgeLength="24dp" android:requiresFadingEdge="vertical"/>
<TextView android:id="@+id/appRename" style="@style/TextSmall" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/rename" android:visibility="gone"/>
<app.olauncher.ui.HomeInfoView android:id="@+id/homeInfo" android:layout_width="192dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:visibility="gone" android:layout_marginBottom="-2dp"/>
<app.olauncher.ui.DockLayout android:id="@+id/dock" android:clickable="true" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" android:padding="4dp" android:background="@drawable/dock_shell" android:layoutDirection="ltr">
<LinearLayout android:id="@+id/dockKeys" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageButton android:id="@+id/dockContacts" android:layout_width="52dp" android:layout_height="52dp" android:layout_margin="4dp" android:padding="13dp" android:background="@drawable/dock_key" android:src="@drawable/dock_contacts" android:contentDescription="Contacts"/>
<Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<ImageButton android:id="@+id/dockBolt" android:layout_width="52dp" android:layout_height="52dp" android:layout_margin="4dp" android:padding="13dp" android:background="@drawable/dock_yellow" android:src="@drawable/dock_bolt" android:contentDescription="Bolt"/>
</LinearLayout>
<androidx.appcompat.widget.SearchView app:layout="@layout/alias_search_view" android:theme="@style/BoltSearchTheme" android:id="@+id/search" android:layout_width="match_parent" android:layout_height="52dp" android:layout_gravity="center_vertical" android:layout_marginStart="64dp" android:layout_marginEnd="64dp" android:visibility="invisible" android:background="@drawable/dock_key" app:iconifiedByDefault="false" app:searchIcon="@null" app:closeIcon="@null" app:queryBackground="@null" app:queryHint="Search Anything" android:imeOptions="actionSearch"/>
<TextView android:id="@+id/homeSearch" android:layout_width="match_parent" android:layout_height="52dp" android:layout_gravity="center_vertical" android:layout_marginStart="64dp" android:layout_marginEnd="64dp" android:paddingHorizontal="16dp" android:gravity="center_vertical" android:text="Search Anything" android:textSize="16sp" android:textColor="#BDBDBD" android:background="@drawable/dock_key" android:contentDescription="Search Anything"/>
<ImageButton android:id="@+id/dockSearch" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="4dp" android:padding="13dp" android:background="@drawable/dock_key" android:src="@drawable/dock_apps" android:visibility="gone" android:contentDescription="Search destination: Apps. Tap to switch; hold to edit Search within Apps"/>
</app.olauncher.ui.DockLayout></LinearLayout>