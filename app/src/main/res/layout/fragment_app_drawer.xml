<?xml version="1.0" encoding="utf-8"?>
<app.olauncher.ui.SearchGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <app.olauncher.ui.SearchPanelLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="@dimen/bolt_search_ime_gap">

        <app.olauncher.ui.DockResultsView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/bolt_search_results_inset"
            android:paddingBottom="@dimen/bolt_result_dock_gap"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/appRename"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rename"
            android:visibility="gone" />

        <TextView
            android:id="@+id/searchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_primary_gradient"
            android:foreground="@drawable/bolt_search_press"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/bolt_search_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/moveModeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:background="@drawable/rounded_primary_gradient"
            android:text="@string/bolt_move_mode_hint"
            android:textColor="?attr/boltHomeMenuTextColor"
            android:textSize="12sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layoutDirection="ltr">

            <app.olauncher.ui.BoltSearchInput
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/bolt_search_button_width"
                android:background="@null"
                android:foreground="@drawable/bolt_search_press"
                android:gravity="start|center_vertical"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:inputType="text|textNoSuggestions"
                android:paddingHorizontal="@dimen/bolt_search_text_inset"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textCursorDrawable="@drawable/bolt_cursor_yellow"
                android:textSize="18sp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/dockSearchDestinations"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/bolt_search_press"
                android:contentDescription="@string/bolt_search_destinations"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:srcCompat="@drawable/dock_search" />

            <TextView
                android:id="@+id/dockActiveAlias"
                style="@style/BoltAliasBadge"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/dockBolt"
                android:layout_width="@dimen/bolt_search_button_width"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/bolt_search_press"
                android:contentDescription="@string/bolt_enable_thunder"
                android:scaleType="center"
                app:srcCompat="@drawable/bolt_search_lightning" />
            <View
                android:id="@+id/dockWebDivider"
                android:layout_width="@dimen/bolt_contact_action_divider_width"
                android:layout_height="18dp"
                android:layout_gravity="end|center_vertical"
                android:background="@color/bolt_search_outline"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dockActions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/contactShortcutSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="true"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/contactShortcuts"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/contactCall"
                            android:layout_width="@dimen/bolt_contact_action_width"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/bolt_action_call"
                            android:scaleType="centerInside"
                            android:paddingHorizontal="9dp"
                            app:srcCompat="@drawable/contact_call" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/contactMessage"
                            android:layout_width="@dimen/bolt_contact_action_width"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/bolt_action_message"
                            android:scaleType="centerInside"
                            android:paddingHorizontal="9dp"
                            app:srcCompat="@drawable/contact_message" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/contactWhatsapp"
                            android:layout_width="@dimen/bolt_contact_action_width"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/bolt_action_whatsapp"
                            android:scaleType="centerInside"
                            android:paddingHorizontal="9dp"
                            app:srcCompat="@drawable/contact_whatsapp" />
                    </LinearLayout>
                </FrameLayout>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/dockWeb"
                    android:layout_width="@dimen/bolt_web_action_width"
                    android:layout_height="match_parent"
                    android:background="@drawable/bolt_search_press"
                    android:contentDescription="@string/bolt_search_web"
                    android:scaleType="centerInside"
                    android:paddingHorizontal="9dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/dock_web" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/renameControls"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/renameConfirm"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="@dimen/bolt_rename_action_width"
                    android:layout_height="match_parent"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp"
                    android:text="@string/rename"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/renameCancel"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="@dimen/bolt_rename_action_width"
                    android:layout_height="match_parent"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp"
                    android:text="@string/close"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

            </LinearLayout>
        </FrameLayout>
    </app.olauncher.ui.SearchPanelLayout>
</app.olauncher.ui.SearchGestureLayout>
