<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bolt_search_result_height"
    android:layout_marginVertical="@dimen/bolt_result_row_margin"
    android:background="@drawable/bolt_search_best_match"
    android:foreground="@drawable/bolt_result_press"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/destinationTitle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="?attr/boltResultTextColor"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/destinationBadge"
        style="@style/BoltAliasBadge"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp" />
</LinearLayout>
