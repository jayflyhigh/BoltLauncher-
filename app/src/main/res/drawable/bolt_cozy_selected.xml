<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item><shape><solid android:color="?attr/boltSelectedRowColor" /><stroke android:width="1dp" android:color="?attr/boltSelectedRowOutlineColor" /><corners android:radius="12dp" /></shape></item>
            <item android:gravity="end|top" android:start="12dp" android:end="12dp" android:top="2dp" android:width="10dp" android:height="8dp" android:drawable="@drawable/bolt_cozy_sprout" />
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
