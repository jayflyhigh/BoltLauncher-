<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/bolt_contact_selected_surface" />
            <corners android:radius="@dimen/bolt_search_corner_radius" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/bolt_search_result" />
            <corners android:radius="@dimen/bolt_search_corner_radius" />
            <stroke android:width="2dp" android:color="@color/bolt_search_yellow" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/bolt_search_result" />
            <corners android:radius="@dimen/bolt_search_corner_radius" />
        </shape>
    </item>
</selector>
