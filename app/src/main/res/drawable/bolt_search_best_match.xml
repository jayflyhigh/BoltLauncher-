<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/boltSelectedRowColor" />
            <stroke android:width="?attr/boltSelectedRowOutlineWidth" android:color="?attr/boltSelectedRowOutlineColor" />
            <corners android:radius="@dimen/bolt_search_corner_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270"
                android:startColor="?attr/boltRowColor"
                android:endColor="?attr/boltRowBottomColor" />
            <stroke android:width="1dp" android:color="?attr/boltRowOutlineColor" />
            <corners android:radius="@dimen/bolt_search_corner_radius" />
        </shape>
    </item>
</selector>
